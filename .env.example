NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Playwright/local automated test auth ---
# Deterministic test harness for Playwright and CI. Never enable in Production.
E2E_MOCK_AUTH=

# Optional for Playwright against an isolated real Supabase test project.
# Leave E2E_MOCK_AUTH unset when using these credentials.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# --- Development auth (SERVER-ONLY - never prefix these with NEXT_PUBLIC_) ---
# Enables mock/dev login over Stub Mode data on non-production environments
# such as local dev and approved Vercel Preview deployments.
# Never honored when VERCEL_ENV=production. Set to the string "true" to enable.
ENABLE_DEV_AUTH=

# Role granted to the dev-auth user. Accepts Administrator/Admin, Leader,
# Student, or Parent (case-insensitive). Defaults to Administrator (admin).
DEV_AUTH_ROLE=

# Deprecated temporary compatibility only.
# Do not add these to new environments. If an older Preview still has them,
# migrate to ENABLE_DEV_AUTH / DEV_AUTH_ROLE and remove the NEXT_PUBLIC_* vars.
# NEXT_PUBLIC_ENABLE_DEV_AUTH=
# NEXT_PUBLIC_DEV_AUTH_ROLE=

# --- EMMA provider settings (SERVER-ONLY) ---
# Default mock mode requires no provider keys and is used for local tests/CI.
# Set EMMA_PROVIDER_MODE=gemini only in an approved server environment.
EMMA_PROVIDER_MODE=mock
EMMA_DEFAULT_PROVIDER=gemini
EMMA_DEFAULT_MODEL=gemini-2.0-flash

# Gemini API key for server-side EMMA provider calls only.
# Never prefix AI provider secrets with NEXT_PUBLIC_.
GEMINI_API_KEY=

# --- Camp EMMA command interpreter settings (SERVER-ONLY) ---
# Preferred provider for Camp EMMA controlled action intent parsing.
# These values are never exposed to the client and must not be prefixed
# with NEXT_PUBLIC_.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Optional direct OpenAI fallback for Camp EMMA controlled action intent
# parsing when Azure OpenAI is not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Camp medication Scan Label helper (SERVER-ONLY) ---
# Defaults off unless set to the exact string "true".
# Never prefix AI provider secrets with NEXT_PUBLIC_.
CAMP_MEDICATION_SCAN_ENABLED=false
