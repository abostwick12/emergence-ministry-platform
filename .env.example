NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Planning Center read-only integration (SERVER-ONLY) ---
# Used by the ministry Settings page to connect Planning Center via OAuth and
# manually sync minimized People / Check-Ins reference data. Never prefix these
# with NEXT_PUBLIC_; tokens are stored server-side only.
PLANNING_CENTER_CLIENT_ID=
PLANNING_CENTER_CLIENT_SECRET=
PLANNING_CENTER_REDIRECT_URI=
# Optional override for tests or non-production API hosts.
# PLANNING_CENTER_API_BASE_URL=https://api.planningcenteronline.com

# --- YouVersion Platform REST API (SERVER-ONLY) ---
# Used by the Student Scripture Hub lookup route. Never prefix with NEXT_PUBLIC_.
YOUVERSION_APP_KEY=
YOUVERSION_API_BASE_URL=https://api.youversion.com

# --- Gloo AI Studio API (SERVER-ONLY) ---
# Used by the Scripture in New Frontiers discussion-generation workflow.
# Never prefix faith-tuned AI provider secrets with NEXT_PUBLIC_.
GLOO_AI_CLIENT_ID=
GLOO_AI_CLIENT_SECRET=
GLOO_AI_BASE_URL=https://platform.ai.gloo.com/ai/v2
GLOO_AI_MODEL=gloo-openai-gpt-5-nano
GLOO_AI_ESCALATION_MODEL=gloo-openai-gpt-5-mini
GLOO_AI_LONG_CONTEXT_MODEL=gloo-google-gemini-2.5-flash-lite

# Compatibility fallbacks for an already-issued bearer token or custom proxy.
# Prefer GLOO_AI_CLIENT_ID + GLOO_AI_CLIENT_SECRET for Gloo AI Studio.
GLOO_AI_STUDIO_API_KEY=
GLOO_AI_STUDIO_API_BASE_URL=

# Deprecated compatibility fallback. Prefer GLOO_AI_MODEL for new environments.
GLOO_AI_STUDIO_MODEL=

# --- Hackathon Slack delivery (SERVER-ONLY) ---
# Fixed private-channel webhook for approved demo discussion posts only.
# Do not use this for automatic student communication.
SLACK_WEBHOOK_URL=

# --- Lead Emerge Daily Intelligence Brief (SERVER-ONLY) ---
# Posts the ministry operations brief to the private #daily-briefing Slack
# channel. This is separate from Command Center and hackathon Slack webhooks.
# The Codex scheduled task should run `npm.cmd run daily-intelligence:brief`,
# which invokes only /api/daily-intelligence/brief. Do not use the Personal
# Command Center briefing route for Lead Emerge ministry operations briefs.
DAILY_BRIEFING_SLACK_WEBHOOK_URL=
# Optional explicit URL for the scheduled Codex runner. If omitted, the runner
# falls back to DAILY_BRIEFING_APP_URL, VERCEL_PROJECT_PRODUCTION_URL, or
# VERCEL_URL.
DAILY_INTELLIGENCE_BRIEF_URL=
# Used to make Slack "Open record" links absolute. Falls back to Vercel URL
# variables when available.
DAILY_BRIEFING_APP_URL=
# The route also accepts CRON_SECRET as a fallback.
DAILY_BRIEFING_CRON_SECRET=

# --- Playwright/local automated test auth ---
# Deterministic test harness for Playwright and CI. Never enable in Production.
E2E_MOCK_AUTH=

# Optional for Playwright against an isolated real Supabase test project.
# Leave E2E_MOCK_AUTH unset when using these credentials.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# --- Development auth (SERVER-ONLY - never prefix these with NEXT_PUBLIC_) ---
# Enables mock/dev login over Stub Mode data on non-production environments
# such as local dev and approved Vercel Preview deployments.
# Never honored when VERCEL_ENV=production. Set to the string "true" to enable.
ENABLE_DEV_AUTH=

# Role granted to the dev-auth user. Accepts Administrator/Admin, Leader,
# Student, or Parent (case-insensitive). Defaults to Administrator (admin).
DEV_AUTH_ROLE=

# Deprecated temporary compatibility only.
# Do not add these to new environments. If an older Preview still has them,
# migrate to ENABLE_DEV_AUTH / DEV_AUTH_ROLE and remove the NEXT_PUBLIC_* vars.
# NEXT_PUBLIC_ENABLE_DEV_AUTH=
# NEXT_PUBLIC_DEV_AUTH_ROLE=

# --- EMMA provider settings (SERVER-ONLY) ---
# Default mock mode requires no provider keys and is used for local tests/CI.
# Set EMMA_PROVIDER_MODE=gemini only in an approved server environment.
EMMA_PROVIDER_MODE=mock
EMMA_DEFAULT_PROVIDER=gemini
EMMA_DEFAULT_MODEL=gemini-3.5-flash

# Gemini API key for server-side EMMA provider calls only.
# Never prefix AI provider secrets with NEXT_PUBLIC_.
GEMINI_API_KEY=

# --- Camp EMMA command interpreter settings (SERVER-ONLY) ---
# Preferred provider for Camp EMMA controlled action intent parsing.
# Camp medication Scan Label also uses the server-only Azure/OpenAI variables
# documented below when enabled. These values are never exposed to the client
# and must not be prefixed with NEXT_PUBLIC_.

# --- SAGE AI Provider (SERVER-ONLY) ---
# Only one SAGE provider is required. SAGE defaults to direct OpenAI unless
# SAGE_AI_PROVIDER=azure is set. Azure uses a deployment name, not a model
# name; for example, AZURE_OPENAI_DEPLOYMENT=emma-camp-test.
# SAGE_AI_PROVIDER=openai

# Direct OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
# SAGE_AI_PROVIDER=azure
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=
# Optional compatibility value for non-SAGE Azure helpers. SAGE Responses
# streaming derives the Azure /openai/v1/ base URL from AZURE_OPENAI_ENDPOINT.
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Camp medication Scan Label helper (SERVER-ONLY) ---
# Defaults off unless set to the exact string "true".
# Never prefix AI provider secrets with NEXT_PUBLIC_.
CAMP_MEDICATION_SCAN_ENABLED=false

# --- Personal Command Center / SAGE (Andrew only, SERVER-ONLY) ---
# Andrew's private command center at /command-center. Gated to a single
# email address (lib/command-center/access.ts). No other user can see or
# configure this feature regardless of these variables.
#
# Phase 1B SAGE chat can use direct OpenAI or Azure OpenAI. If provider config
# is missing, /command-center/chat stays available with a graceful
# "not configured" state. Never prefix provider variables with NEXT_PUBLIC_.

# Phase 2 - web crawling for the daily resource feed.
# FIRECRAWL_API_KEY=

# Phase 2 - Slack webhook for Command Center notifications and daily
# briefings. Deliberately a distinct variable from the hackathon
# SLACK_WEBHOOK_URL above (lib/scripture/slack.ts) so Andrew's personal
# notifications never post to the shared demo channel.
# COMMAND_CENTER_SLACK_WEBHOOK_URL=

# Phase 2 - Google OAuth (Calendar, Gmail, Drive share one consent screen).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Phase 3 - Monday.com personal API token (no OAuth required).
# MONDAY_API_TOKEN=

# Phase 3 - LinkedIn has no configured API integration yet. SAGE only
# drafts post/outreach text for Andrew to copy and post manually; no env
# var is required for that.
