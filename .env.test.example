# Optional deterministic Playwright harness overrides. No provider credentials are needed.
NEXT_TELEMETRY_DISABLED=1
E2E_HARNESS_ACTIVE=true
E2E_MOCK_AUTH=true
E2E_EXTERNAL_NETWORK=disabled
E2E_HOST=127.0.0.1
E2E_PORT=3100
E2E_HEALTH_PATH=/login
E2E_STARTUP_TIMEOUT_MS=90000
E2E_GLOBAL_TIMEOUT_MS=900000
E2E_TEST_TIMEOUT_MS=45000
E2E_EXPECT_TIMEOUT_MS=8000
E2E_RETRIES=1
E2E_WORKERS=1
NEXT_PUBLIC_E2E_YOUVERSION_FIXTURE=true
VERCEL_ENV=
ENABLE_DEV_AUTH=false
NEXT_PUBLIC_ENABLE_DEV_AUTH=
